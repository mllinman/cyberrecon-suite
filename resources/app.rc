#include <windows.h>

// Application icon
IDI_ICON1 ICON "shield-icon.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,7,0,0
PRODUCTVERSION  1,7,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CyberRecon Solutions"
            VALUE "FileDescription", "CyberRecon Suite - Modern Cybersecurity Operations Platform"
            VALUE "FileVersion", "1.7.0.0"
            VALUE "InternalName", "cyberrecon-suite"
            VALUE "LegalCopyright", "© 2024 CyberRecon Solutions"
            VALUE "LegalTrademarks", "CyberRecon Suite™"
            VALUE "OriginalFilename", "CyberReconSuite.exe"
            VALUE "ProductName", "CyberRecon Suite"
            VALUE "ProductVersion", "1.7.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END